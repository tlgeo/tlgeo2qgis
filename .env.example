# TLGeo2QGIS Plugin Environment Variables
# Copy this file to .env and update with your actual values

# ============================================================================
# GEOADMIN API Configuration
# ============================================================================

# GEOADMIN Strapi backend URL
GEOADMIN_STRAPI_URL=http://localhost:1337

# ============================================================================
# FRMS Database Configuration
# ============================================================================

# Database Host (default: localhost)
FRMS_DB_HOST=localhost

# Database Port (default: 5432, your custom: 8088)
FRMS_DB_PORT=8088

# Database Name
FRMS_DB_NAME=data_forest

# Database User
FRMS_DB_USER=postgres

# Database Password
# ⚠️ NEVER commit the actual .env file with real passwords!
FRMS_DB_PASSWORD=newpassword

# Connection Timeout (seconds)
FRMS_DB_TIMEOUT=10

# SSL Mode (disable, allow, prefer, require, verify-ca, verify-full)
FRMS_DB_SSL_MODE=prefer

# ============================================================================
# LLM Agent Configuration (TLGeoAgent)
# ============================================================================

# MiniMax API Key for LLM
MINIMAX_API_KEY=your_minimax_api_key_here

# MiniMax Model
MINIMAX_MODEL=MiniMax-M2.7

# OpenAI Base URL (for MiniMax compatible API)
OPENAI_BASE_URL=https://api.minimax.io/v1

# System Prompt for Agent
SYSTEM_PROMPT=Bạn là trợ lý của tôi, giúp tôi trả lời các câu hỏi của tôi một cách ngắn gọn và chính xác nhất có thể.

# ============================================================================
# Plugin Settings
# ============================================================================

# Enable debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
