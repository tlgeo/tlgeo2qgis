# TLGeo2QGIS Plugin Environment Variables
# Copy this file to .env and update with your actual values

# ============================================================================
# GEOADMIN API Configuration
# ============================================================================

# GEOADMIN Strapi backend URL
GEOADMIN_STRAPI_URL=http://localhost:1337

# GeoAI Agent WebSocket URL
TLGEO_AGENT_URL=ws://localhost:13001/ws/qgis

# ============================================================================
# FRMS Database Configuration
# ============================================================================

# Database Host (default: localhost)
FRMS_DB_HOST=localhost

# Database Port (default: 5432, your custom: 8088)
FRMS_DB_PORT=8088

# Database Name
FRMS_DB_NAME=data_forest

# Database User
FRMS_DB_USER=postgres

# Database Password
# ⚠️ NEVER commit the actual .env file with real passwords!
FRMS_DB_PASSWORD=newpassword

# Connection Timeout (seconds)
FRMS_DB_TIMEOUT=10

# SSL Mode (disable, allow, prefer, require, verify-ca, verify-full)
FRMS_DB_SSL_MODE=prefer

# ============================================================================
# Plugin Settings
# ============================================================================

# Enable debug mode
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
